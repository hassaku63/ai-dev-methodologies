{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": ["Read(./**/.env)", "Bash(git push --force:*)", "Bash(git push -f:*)"]
  },
  "extraKnownMarketplaces": {
    "ai-dev-methodologies": {
      "source": {
        "source": "github",
        "repo": "hassaku63/ai-dev-methodologies"
      }
    }
  },
  "enabledPlugins": {
    "core@ai-dev-methodologies": true
  }
}
